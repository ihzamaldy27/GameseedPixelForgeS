      - title: Dialogue Text
        value: 
        type: 0
        typeString: 
      - title: Sequence
        value: 'CinemachinePriority(CinemachineChaseCam, 100);

          CinemachineTarget(CinemachineChaseCam,
          ChaseTarget, look);

          DOTweenLetterbox(130, 1.5);

          AnimatorPlay(Idle,
          EnemyChase);

          SpawnBullet(ChaseBulletPrefab, 60, -3, Player,
          10)@2;

          SetTimeScale(0.3, 1.5)@3.5;

          Fade(stay, 1.5,
          #FFFFFF)@3.5;

          AnimatorPlay(Fall, MainPlayer)@4;

          SetTimeScale(1,
          0.5)@5;

          StopPlayer()@5;

          SpawnCutsceneEnemies(81,
          82)@5;

          AnimatorPlay(FallGround, MainPlayer)@5.5;

          Fade(unstay,
          1, #FFFFFF)@6;

          Continue()@7;'
        type: 0
        typeString: 
